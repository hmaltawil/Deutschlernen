rules_version = '2';
// Lücke sync: progress is stored under sync/<id>/chunks/<chunk>, where <id> is the
// SHA-256 of a secret sync code. Knowing the code is the only way to read or write.
// Nothing can be listed across codes, and nothing can be deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sync/{syncId}/chunks/{chunkId} {
      allow read: if syncId.matches('^[0-9a-f]{64}$');
      allow create, update: if syncId.matches('^[0-9a-f]{64}$')
        && chunkId.matches('^[a-z0-9]{1,12}$')
        && request.resource.data.keys().hasOnly(['v', 'data', 'updated'])
        && request.resource.data.v is int
        && request.resource.data.updated is int
        && request.resource.data.data is string
        && request.resource.data.data.size() < 400000;
    }
  }
}
